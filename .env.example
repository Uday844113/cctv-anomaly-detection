# CCTV Anomaly Detection - Environment Configuration
# Copy this file to .env and fill in values. Never commit .env.

# --- Application ---
APP_NAME=CCTV Anomaly Detection
APP_VERSION=1.0.0
DEBUG=false
HOST=127.0.0.1
PORT=8000

# --- Paths (leave empty to use project-relative defaults)#
MODELS_DIR=
DATA_DIR=
LOGS_DIR=
DATABASE_URL=sqlite:///./data/cctv_events.db

# --- Detection / inference ---
INFERENCE_WIDTH=640
INFERENCE_HEIGHT=640
FRAME_SKIP=2
TARGET_FPS=15
PERSON_CONF=0.25
FIRE_SMOKE_CONF=0.25
FALL_CONF=0.6
FIGHT_CONF=0.6
CROWD_VIOLENCE_CONF=0.6
RUNNING_CONF=0.6

# --- Model paths (YOLO .pt weights). Empty = download on demand. ---
PERSON_MODEL=yolo11n.pt
FIRE_SMOKE_MODEL=
FALL_MODEL=
FIGHT_MODEL=

# --- Camera / RTSP ---
RTSP_TIMEOUT=10
CAMERA_RECONNECT_DELAY=3
MAX_FPS_PER_STREAM=30

# --- Recording ---
PRE_EVENT_SECONDS=5
POST_EVENT_SECONDS=10
INCIDENT_BUFFER_FRAMES=300
RETENTION_DAYS=30

# --- Security ---
SECRET_KEY=change-me-in-production
API_TOKEN=
ALLOWED_HOSTS=127.0.0.1,localhost